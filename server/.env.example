# ========================================================
# UniSync CSE - Backend Environment Configuration (Render / Production)
# ========================================================

# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/unisync_db?retryWrites=true&w=majority

# JWT Security Secrets (Use long random 32+ character strings)
JWT_ACCESS_SECRET=replace_with_strong_random_secret_32_chars_minimum
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Frontend Vercel URL (Allowed CORS Origin for cookies & sockets)
CLIENT_URL=https://your-unisync-app.vercel.app

# Groq AI Assistant API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Institutional SMTP for Department Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# (Optional) SMS Provider API Key
SMS_PROVIDER_API_KEY=
